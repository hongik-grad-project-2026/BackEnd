# Copy these variable names to /opt/mulmi/backend.env on the EC2 instance.
# Keep the real file outside Git and readable only by root.
DB_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/mulmi?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=admin
DB_PASSWORD=YOUR_RDS_PASSWORD
JWT_TOKEN_SECRETKEY=YOUR_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
