      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-northeast-2::document/AWS-RunShellScript",
        "arn:aws:ec2:ap-northeast-2:563586109665:instance/i-0c9e8d2a963a41f3b"
      ]
    },
    {
      "Sid": "ReadDeploymentResult",
